{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./",
    "baseUrl": ".",
    "paths": {
      "@pages/*": ["pages/*"],
      "@steps/*": ["steps/*"],
      "@data/*": ["test-data/*"],
      "@data-utils/*": ["data-utils/*"],
      "@test-data-excel/*": ["test-data-excel/*"]
    },
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "tests",
    "steps",
    "pages",
    "test-data",
    "data-utils",
    "test-data-excel",
    "types",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test-results",
    "playwright-report",
    "html-report",
    "allure-results",
    "allure-report"
  ]
}
