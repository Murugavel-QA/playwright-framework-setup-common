    "@types/pg": "^8.15.5",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.4.1",
    "cross-env": "^10.0.0",
    "playwright-bdd": "^8.4.1",
    "typescript": "^5.9.3"
  },
